digraph ERD {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.7", ranksep="1.4", splines=polyline, fontname="DejaVu Sans"];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#44617c",penwidth=1.5,arrowsize=.7,fontname="DejaVu Sans",fontsize=9];
gracz [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#aab9c8"><TR><TD COLSPAN="2" BGCOLOR="#cfe1fa"><B>GRACZ</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf1fc"><FONT COLOR="#163d7b">PK id_gracza</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">UNIQUE roblox_user_id</FONT></TD><TD ALIGN="LEFT">bigint</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">nazwa</FONT></TD><TD ALIGN="LEFT">varchar(50)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">gotowka</FONT></TD><TD ALIGN="LEFT">decimal(12,2)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">saldo_banku</FONT></TD><TD ALIGN="LEFT">decimal(12,2)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">poziom_poszukiwan</FONT></TD><TD ALIGN="LEFT">int</TD></TR></TABLE>>];
pojazd [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#aab9c8"><TR><TD COLSPAN="2" BGCOLOR="#cfe1fa"><B>POJAZD</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf1fc"><FONT COLOR="#163d7b">PK id_pojazdu</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e7f3ec"><FONT COLOR="#175b34">FK id_gracza</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">model</FONT></TD><TD ALIGN="LEFT">varchar(60)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">kolor</FONT></TD><TD ALIGN="LEFT">varchar(30)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">stan</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">tuning</FONT></TD><TD ALIGN="LEFT">varchar(255)</TD></TR></TABLE>>];
przedmiot [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#aab9c8"><TR><TD COLSPAN="2" BGCOLOR="#cfe1fa"><B>PRZEDMIOT</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf1fc"><FONT COLOR="#163d7b">PK id_przedmiotu</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">nazwa</FONT></TD><TD ALIGN="LEFT">varchar(70)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">kategoria</FONT></TD><TD ALIGN="LEFT">varchar(30)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">cena</FONT></TD><TD ALIGN="LEFT">decimal(12,2)</TD></TR></TABLE>>];
ekwipunek [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#aab9c8"><TR><TD COLSPAN="2" BGCOLOR="#cfe1fa"><B>EKWIPUNEK</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf1fc"><FONT COLOR="#163d7b">PK id_pozycji</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e7f3ec"><FONT COLOR="#175b34">FK id_gracza</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e7f3ec"><FONT COLOR="#175b34">FK id_przedmiotu</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">ilosc</FONT></TD><TD ALIGN="LEFT">int</TD></TR></TABLE>>];
misja [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#aab9c8"><TR><TD COLSPAN="2" BGCOLOR="#cfe1fa"><B>MISJA</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf1fc"><FONT COLOR="#163d7b">PK id_misji</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">nazwa</FONT></TD><TD ALIGN="LEFT">varchar(80)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">typ</FONT></TD><TD ALIGN="LEFT">varchar(30)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">nagroda</FONT></TD><TD ALIGN="LEFT">decimal(12,2)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">opis</FONT></TD><TD ALIGN="LEFT">varchar(255)</TD></TR></TABLE>>];
postep_misji [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#aab9c8"><TR><TD COLSPAN="2" BGCOLOR="#cfe1fa"><B>POSTEP_MISJI</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf1fc"><FONT COLOR="#163d7b">PK id_postepu</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e7f3ec"><FONT COLOR="#175b34">FK id_gracza</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e7f3ec"><FONT COLOR="#175b34">FK id_misji</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">status</FONT></TD><TD ALIGN="LEFT">varchar(20)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">NULL data_ukonczenia</FONT></TD><TD ALIGN="LEFT">datetime</TD></TR></TABLE>>];
napad [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#aab9c8"><TR><TD COLSPAN="2" BGCOLOR="#cfe1fa"><B>NAPAD</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf1fc"><FONT COLOR="#163d7b">PK id_napadu</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e7f3ec"><FONT COLOR="#175b34">FK id_gracza</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">lokalizacja</FONT></TD><TD ALIGN="LEFT">varchar(80)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">wynik</FONT></TD><TD ALIGN="LEFT">varchar(20)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">lup</FONT></TD><TD ALIGN="LEFT">decimal(12,2)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">czas_rozpoczecia</FONT></TD><TD ALIGN="LEFT">datetime</TD></TR></TABLE>>];
bron [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#aab9c8"><TR><TD COLSPAN="2" BGCOLOR="#cfe1fa"><B>BRON</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf1fc"><FONT COLOR="#163d7b">PK id_broni</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e7f3ec"><FONT COLOR="#175b34">FK UNIQUE id_przedmiotu</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">obrazenia</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">pojemnosc_magazynka</FONT></TD><TD ALIGN="LEFT">int</TD></TR></TABLE>>];
transakcja [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" COLOR="#aab9c8"><TR><TD COLSPAN="2" BGCOLOR="#cfe1fa"><B>TRANSAKCJA</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eaf1fc"><FONT COLOR="#163d7b">PK id_transakcji</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e7f3ec"><FONT COLOR="#175b34">FK id_gracza</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e7f3ec"><FONT COLOR="#175b34">FK NULL id_pojazdu</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e7f3ec"><FONT COLOR="#175b34">FK NULL id_przedmiotu</FONT></TD><TD ALIGN="LEFT">int</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">typ</FONT></TD><TD ALIGN="LEFT">varchar(30)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">kwota</FONT></TD><TD ALIGN="LEFT">decimal(12,2)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#222222">data_transakcji</FONT></TD><TD ALIGN="LEFT">datetime</TD></TR></TABLE>>];
gracz -> pojazd [label="posiada",taillabel="1",headlabel="0..*",dir=none];
gracz -> ekwipunek [label="ma",taillabel="1",headlabel="0..*",dir=none];
przedmiot -> ekwipunek [label="występuje w",taillabel="1",headlabel="0..*",dir=none];
gracz -> postep_misji [label="realizuje",taillabel="1",headlabel="0..*",dir=none];
misja -> postep_misji [label="jest realizowana",taillabel="1",headlabel="0..*",dir=none];
gracz -> napad [label="wykonuje",taillabel="1",headlabel="0..*",dir=none];
przedmiot -> bron [label="specjalizacja",taillabel="1",headlabel="0..*",dir=none];
gracz -> transakcja [label="wykonuje",taillabel="1",headlabel="0..*",dir=none];
pojazd -> transakcja [label="dotyczy",taillabel="1",headlabel="0..*",dir=none];
przedmiot -> transakcja [label="dotyczy",taillabel="1",headlabel="0..*",dir=none];
}